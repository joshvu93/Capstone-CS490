/* =============================================
   Main Window
   ============================================= */

QMainWindow {
    background-color: #f4f4f4;
}


/* =============================================
   Scroll Area
   ============================================= */

QScrollArea {
    border: none;
    background-color: #f4f4f4;
}

QScrollArea QWidget {
    color: #222222;
}


/* =============================================
   Sections
   ============================================= */

QGroupBox {
    color: #222222;

    font-size: 13px;
    font-weight: bold;

    background-color: white;

    border: 1px solid #cccccc;
    border-radius: 6px;

    margin-top: 16px;
    padding: 4px;
}


QGroupBox::title {
    color: #222222;

    subcontrol-origin: margin;
    subcontrol-position: top left;

    left: 10px;

    padding: 0 5px;
}


/* =============================================
   Labels
   ============================================= */

QLabel {
    color: #222222;

    font-size: 13px;
    font-weight: normal;
}


/* =============================================
   Input Fields
   ============================================= */

QLineEdit {
    color: #222222;

    background-color: white;

    padding: 3px;

    border: 1px solid #bbbbbb;
    border-radius: 4px;
}


/* =============================================
   Dropdown Menus
   ============================================= */

QComboBox {
    color: #222222;

    background-color: white;

    padding: 3px;

    border: 1px solid #bbbbbb;
    border-radius: 4px;
}


QComboBox QAbstractItemView {
    color: #222222;
    background-color: white;
}


/* =============================================
   Buttons
   ============================================= */

QPushButton {
    color: #222222;

    background-color: #eeeeee;

    padding: 4px 10px;

    border: 1px solid #aaaaaa;
    border-radius: 5px;
}


QPushButton:hover {
    background-color: #dddddd;
}


QPushButton:pressed {
    background-color: #cccccc;
}


/* toggle buttons that are switched on */
QPushButton:checked {
    background-color: #dde7ef;
    border: 1px solid #376A92;
}

QPushButton:disabled,
QComboBox:disabled,
QLineEdit:disabled {
    color: #999999;
    border-color: #cccccc;
}

QPushButton#primary {
    color: white;
    background-color: #376A92;
    border-color: #376A92;
}

QPushButton#primary:hover {
    background-color: #2F5B7E;
}

QPushButton#primary:pressed {
    background-color: #264A66;
}

QPushButton#primary:disabled {
    color: #999999;
    background-color: #e4e4e4;
    border-color: #cccccc;
}

/* collapsible panels have no title */
QGroupBox#panel {
    margin-top: 0;
}

QLabel#file_status {
    background-color: #f0f0f0;
    border-radius: 4px;
    padding: 3px 6px;
}

/* focused inputs (spin boxes stay unstyled so their arrows work) */
QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #376A92;
}

QLineEdit,
QComboBox QAbstractItemView {
    selection-background-color: #376A92;
    selection-color: white;
}

/* loaded files and registered calibration */
QLabel#file_status[success="true"],
QLabel#parameter_status[success="true"] {
    color: #427653;
}

/* warning and error dialogs */
QMessageBox QLabel {
    color: #BC4141;
}
