/* =============================================
   Main Window
   ============================================= */

QMainWindow {
    background-color: #f4f4f4;
}


/* =============================================
   Scroll Area
   ============================================= */

QScrollArea {
    border: none;
    background-color: #f4f4f4;
}

QScrollArea QWidget {
    color: #222222;
}


/* =============================================
   Sections
   ============================================= */

QGroupBox {
    color: #222222;

    font-size: 15px;
    font-weight: bold;

    background-color: white;

    border: 1px solid #cccccc;
    border-radius: 6px;

    margin-top: 18px;
    padding: 15px;
}


QGroupBox::title {
    color: #cccccc;

    subcontrol-origin: margin;
    subcontrol-position: top left;

    left: 10px;

    padding: 0 5px;
}


/* =============================================
   Labels
   ============================================= */

QLabel {
    color: #222222;

    font-size: 13px;
    font-weight: normal;
}


/* =============================================
   Input Fields
   ============================================= */

QLineEdit {
    color: #cccccc;

    background-color: white;

    padding: 6px;

    border: 1px solid #bbbbbb;
    border-radius: 4px;
}


QLineEdit::placeholder {
    color: #888888;
}


/* =============================================
   Dropdown Menus
   ============================================= */

QComboBox {
    color: #222222;

    background-color: white;

    padding: 6px;

    border: 1px solid #bbbbbb;
    border-radius: 4px;
}


QComboBox QAbstractItemView {
    color: #222222;
    background-color: white;
}


/* =============================================
   Buttons
   ============================================= */

QPushButton {
    color: #222222;

    background-color: #eeeeee;

    padding: 8px 14px;

    border: 1px solid #aaaaaa;
    border-radius: 5px;
}


QPushButton:hover {
    background-color: #dddddd;
}


QPushButton:pressed {
    background-color: #cccccc;
}